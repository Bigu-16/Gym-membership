APP_NAME=Taekwondo Club API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gym_membership
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Deployment override for Neon/Render. If set, this takes precedence over POSTGRES_*.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Render and other hosted Redis providers can supply this override.
# REDIS_URL=redis://user:password@host:6379/0
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
FRONTEND_ORIGIN=https://gym-membership-beta.vercel.app
# Additional comma-separated origins. Trailing slashes are normalized automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
