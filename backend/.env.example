APP_NAME=Gym Management Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gym_membership
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Deployment override for Neon/Render. If set, this takes precedence over POSTGRES_*.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Render and other hosted Redis providers can supply this override.
# REDIS_URL=redis://user:password@host:6379/0
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Messaging / notifications ---
# When true, unconfigured channels log the message and report success (safe for dev/testing).
# Set to false in production so only configured channels actually dispatch.
MESSAGING_DEV_MODE=true
NOTIFICATION_MAX_ATTEMPTS=3

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gym Membership
SMTP_USE_TLS=true
